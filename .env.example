# ==============================================================================
# Clinical Guideline Navigator - Environment Variables Template
# Copy this file to backend/.env and frontend/.env.local (or set system env vars)
# NEVER commit real API keys or service role secrets to version control.
# ==============================================================================

# --- Backend Configuration (backend/.env) ---
# Supabase PostgreSQL & pgvector connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

# Groq LLM API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Local Vector Embeddings (HuggingFace / sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SIMILARITY_THRESHOLD=0.45
TOP_K=5

# Backend Server Host & Port
HOST=127.0.0.1
PORT=8000

# --- Frontend Configuration (frontend/.env.local) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
VITE_API_BASE_URL=http://127.0.0.1:8000
